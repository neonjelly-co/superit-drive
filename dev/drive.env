# Settings for running the Drive on this computer against the stand-in storage (`make dev-storage`).
# Development values only: nothing here is a real secret.
DRIVE_STORAGE_URL=http://127.0.0.1:8081
DRIVE_STORAGE_USER=drive
DRIVE_STORAGE_PASSWORD=drive-test-password
DRIVE_STORAGE_FOLDER=/drive
DRIVE_CAPACITY=1TB
DRIVE_ADDRESS=http://127.0.0.1:8080
DRIVE_PROJECT_NAME="Kovács Accounting"
DRIVE_HEADER_SECRET=dev-secret-dev-secret-dev-secret-0000
DRIVE_MEMBERS_FILE=dev/members.json
DRIVE_DATA_DIR=dev/data
DRIVE_LISTEN=127.0.0.1:8080

# Who `make dev-ui` signs in as: a userId from dev/members.json.
DEV_USER_ID=dev-reka

# Settings for the example: copy this file to .env and fill it in. Every secret and password here is an example:
# replace them all before real use (a good secret: openssl rand -hex 32).

# The version of the Drive to run, one published at ghcr.io/neonjelly-co/superit-drive, such as 1.2.0. Until one is
# published, build your own from the repository's top folder and set dev here:
#   docker build -t ghcr.io/neonjelly-co/superit-drive:dev .
DRIVE_VERSION=

DRIVE_PROJECT_NAME=Example Ltd

# The secret Caddy adds to every signed-in request as Drive-Secret. At least 32 characters, and your own: whoever knows
# it and reaches the Drive's port is whoever they say they are. Make one with: openssl rand -hex 32
DRIVE_HEADER_SECRET=

# The WebDAV server that holds the files: here, the stand-in in compose.yaml and its example login.
DRIVE_STORAGE_URL=http://storage
DRIVE_STORAGE_USER=drive
DRIVE_STORAGE_PASSWORD=drive-test-password
DRIVE_STORAGE_FOLDER=/drive
# The size of the storage, such as 1TB. Leave it empty when you do not know it.
DRIVE_CAPACITY=

# The mail server the Drive sends "shared with you" mail through. Leave DRIVE_SMTP_HOST empty for no mail: sharing works
# the same. Port 587 uses STARTTLS and 465 TLS from the first byte; DRIVE_MAIL_FROM is needed with a mail server.
DRIVE_SMTP_HOST=
DRIVE_SMTP_PORT=
DRIVE_SMTP_USER=
DRIVE_SMTP_PASSWORD=
DRIVE_MAIL_FROM=

# Authelia's own secrets. Examples.
AUTHELIA_SESSION_SECRET=example-only-session-secret-0123456789abcdef
AUTHELIA_STORAGE_ENCRYPTION_KEY=example-only-storage-key-0123456789abcdef
